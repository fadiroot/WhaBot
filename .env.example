# --- Core ---------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-please-rotate-in-production
PUBLIC_BASE_URL=http://localhost:8000

# --- Mongo & Redis (overridden by docker-compose for in-cluster names) --
MONGO_URI=mongodb://localhost:27017
MONGO_DB=ai_wa_engineer
REDIS_URL=redis://localhost:6379/0

# --- WAHA ---------------------------------------------------------------
WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_ACCEPT_FROM_ME=false
# Docker Compose only: Apple Silicon — native image avoids Chromium/Puppeteer timeouts under amd64 emulation.
# On Linux or Intel amd64, leave unset or use: WAHA_IMAGE=devlikeapro/waha:latest
# WAHA_IMAGE=devlikeapro/waha:arm
# WAHA web UI at http://localhost:3000/dashboard (HTTP Basic Auth). Override in production.
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=choose-a-strong-password
# Swagger UI basic auth (the API key WAHA_API_KEY is also required for /api/* calls).
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=choose-a-strong-password
# Optional shared secret to validate WAHA webhook calls.
WAHA_WEBHOOK_SECRET=

# --- AI -----------------------------------------------------------------
# Who answers chat: auto | azure | openai
# - openai = any OpenAI-compatible HTTP API (Groq free tier, local Ollama, OpenAI, …)
# - azure = Azure OpenAI only
# - auto = Azure if AZURE_OPENAI_ENDPOINT+KEY set, else OPENAI_*
# Default: auto (Azure if AZURE_* set, else OPENAI_*). Use openai for Ollama/Groq.
LLM_PROVIDER=auto
# auto = use OpenAI tools= API except for Ollama URLs (then JSON tool protocol). false = always JSON protocol.
LLM_NATIVE_TOOLS=auto

OPENAI_API_KEY=
# Optional. Must be a full URL with https://, or leave empty for OpenAI’s default (api.openai.com).
# Examples: https://api.openai.com/v1   or   https://YOUR-RESOURCE.openai.azure.com/openai
# If you omit the scheme (wrong: api.openai.com), the app will prepend https:// automatically.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
# LLM rounds (each tool call = one round in JSON/Ollama mode). Raise if “step limit” on multi-step edits.
AI_MAX_TOOL_ITERATIONS=20

# --- Azure OpenAI (use these instead of OPENAI_* when on Azure) ----------
# When AZURE_OPENAI_ENDPOINT and AZURE_OPENAI_API_KEY are set, the app uses AsyncAzureOpenAI.
# Leave OPENAI_API_KEY empty if you only use Azure.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Must match the deployment name in Azure AI Studio / portal (not necessarily the model marketing name).
AZURE_OPENAI_DEPLOYMENT=
# Optional: separate embedding deployment for code search/RAG (defaults to OPENAI_EMBEDDINGS_MODEL as deployment name).
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=

# --- Ollama (local — copy these into .env when ready) --------------------
# Install: https://ollama.com  →  ollama pull llama3.2  →  ollama pull nomic-embed-text
# Backend in Docker must reach the host: OPENAI_BASE_URL below + extra_hosts in docker-compose.
# Clear AZURE_OPENAI_ENDPOINT or set LLM_PROVIDER=openai so "auto" does not pick Azure.
# If OPENAI_BASE_URL looks like Ollama and OPENAI_EMBEDDINGS_MODEL is still text-embedding-3-small,
# the app uses nomic-embed-text automatically (pull that model on the host).
#
# LLM_PROVIDER=openai
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_MODEL=llama3.2
# OPENAI_EMBEDDINGS_MODEL=nomic-embed-text

# --- Groq (free tier API) -----------------------------------------------
# LLM_PROVIDER=openai
# OPENAI_API_KEY=gsk_your_key_here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# --- GitHub -------------------------------------------------------------
# PAT: classic → `repo`; fine-grained → **Contents** + **Pull requests** Read and write (both needed for push + open PR).
GITHUB_TOKEN=
GITHUB_DEFAULT_ORG=

# --- Workspace / sandbox -----------------------------------------------
WORKSPACE_ROOT=/tmp/ai-wa-workspaces

# --- Approvals ----------------------------------------------------------
REQUIRE_APPROVAL_FOR_PUSH=true
REQUIRE_APPROVAL_FOR_DEPLOY=true

# --- CORS ---------------------------------------------------------------
# JSON list, parsed by pydantic-settings.
CORS_ORIGINS=["http://localhost:5173", "http://localhost:8080", "http://localhost:3000"]
